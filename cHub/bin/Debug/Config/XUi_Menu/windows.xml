<?xml version="1.0" encoding="utf-8"?>
<configs>
  <set xpath="/windows/window[@name='menuBackground']/texture[@name='bgTexture']/@texture">@modfolder:UI/chub-startup-wallpaper-v1.png</set>
  <!-- Keep the c/Hub wallpaper as a fallback, then render the game's native
       zombie menu movie above it. The shipped VideoPlayer already loops this
       URI and is much safer than animated GIF decoding inside XUi. -->
  <set xpath="/windows/window[@name='menuBackground']/video[@name='videoTexture']/@uri">/Video/MenuBackground</set>
  <set xpath="/windows/window[@name='menuBackground']/video[@name='videoTexture']/@loop">true</set>
  <set xpath="/windows/window[@name='menuBackground']/video[@name='videoTexture']/@videoaspect">FitInside</set>
  <!-- Native LoadingScreen controller keeps driving title, tips and connection state. -->
  <set xpath="/windows/window[@name='loadingScreen']/@controller">XUiC_cHubLoadingScreen, cHub</set>
  <!-- @modfolder is resolved while parsing XML, so keep each asset path static.
       The controller rotates visibility instead of returning a macro as text. -->
  <!-- Replace the vanilla binding itself, so there is no default-art fallback. -->
  <set xpath="/windows/window[@name='loadingScreen']/texture[@name='loading_image']/@texture">@modfolder:UI/chub-loading-forest-v2.png</set>
  <set xpath="/windows/window[@name='loadingScreen']/texture[@name='loading_image']/@keepsourceaspectratio">false</set>
  <append xpath="/windows/window[@name='loadingScreen']">
    <texture name="chub_loading_forest" depth="3" texture="@modfolder:UI/chub-loading-forest-v2.png" color="255,255,255,255" anchor_left="#cam,0,-5" anchor_bottom="#cam,0,250" anchor_right="#cam,1,5" anchor_top="#cam,1,5" keepsourceaspectratio="false" visible="{chub_loading_forest}" />
    <texture name="chub_loading_eclipse" depth="3" texture="@modfolder:UI/chub-loading-eclipse-v2.png" color="255,255,255,255" anchor_left="#cam,0,-5" anchor_bottom="#cam,0,250" anchor_right="#cam,1,5" anchor_top="#cam,1,5" keepsourceaspectratio="false" visible="{chub_loading_eclipse}" />
    <texture name="chub_loading_bunker" depth="3" texture="@modfolder:UI/chub-loading-bunker-v2.png" color="255,255,255,255" anchor_left="#cam,0,-5" anchor_bottom="#cam,0,250" anchor_right="#cam,1,5" anchor_top="#cam,1,5" keepsourceaspectratio="false" visible="{chub_loading_bunker}" />
    <rect depth="30" width="640" height="228" anchor_left="#cam,1,-664" anchor_right="#cam,1,-24" anchor_bottom="#cam,1,-270" anchor_top="#cam,1,-42">
      <sprite depth="1" sprite="menu_empty3px" color="5,7,10,225" type="sliced" />
      <sprite depth="3" width="5" height="228" sprite="menu_empty3px" color="220,35,44,255" />
      <sprite depth="4" sprite="menu_empty3px" color="120,125,132,180" type="sliced" fillcenter="false" />
      <label depth="10" pos="24,-14" width="300" height="30" font_size="23" text="c/Hub Status" color="255,74,82,255" effect="outline" effect_color="35,0,3,255" effect_distance="2,-2" />
      <label depth="10" pos="470,-16" width="142" height="27" justify="right" font_size="16" text="LIVE SESSION" color="105,225,145,255" />
      <sprite depth="7" pos="22,-51" width="590" height="2" sprite="menu_empty3px" color="220,35,44,210" />
      <label depth="8" pos="24,-69" width="592" height="34" font_size="22" text="{chub_connection_typewriter}" color="255,232,232,255" effect="outline" effect_color="40,0,3,255" effect_distance="2,-2" />
      <sprite depth="7" pos="22,-112" width="590" height="1" sprite="menu_empty3px" color="105,108,114,150" />
      <label depth="8" pos="24,-128" width="112" height="22" font_size="15" text="SERVER" color="235,61,68,255" />
      <label depth="8" pos="132,-128" width="470" height="24" font_size="18" text="{chub_server_name}" color="245,240,240,255" />
      <label depth="8" pos="24,-160" width="86" height="22" font_size="15" text="ADDRESS" color="235,61,68,255" />
      <label depth="8" pos="132,-160" width="210" height="23" font_size="17" text="{chub_server_ip}" color="210,215,220,255" />
      <label depth="8" pos="354,-160" width="54" height="22" font_size="15" text="PORT" color="235,61,68,255" />
      <label depth="8" pos="412,-160" width="190" height="23" font_size="17" text="{chub_server_port}" color="210,215,220,255" />
      <label depth="8" pos="24,-192" width="86" height="22" font_size="15" text="HOST" color="235,61,68,255" />
      <label depth="8" pos="132,-192" width="470" height="23" font_size="17" text="{chub_hosted_by}" color="105,195,245,255" />
    </rect>
  </append>
  <set xpath="/windows/window[@name='loadingScreen']/fullscreencollider[@name='pnlBlack']/@color">0,0,0,255</set>
  <set xpath="/windows/window[@name='loadingScreen']/sprite[@name='backgroundMain']/@color">0,0,0,255</set>
  <set xpath="/windows/window[@name='loadingScreen']/rect[@name='tips_enabled']/label[@name='lblTitle']/@color">255,55,62,255</set>
  <!-- This must be a child of mainMenu, not a globally opened window. Global
       windows remain visible over Play Game / saved-game screens. -->
  <append xpath="/windows/window[@name='mainMenu']">
	  <rect name="chubMainMenuBrand"
			pos="-112,72"
			width="650"
			height="48"
			depth="20"
			controller="XUiC_cHubMainMenuBrand, cHub"
			cursor_area="true">

		  <sprite depth="1"
				  width="650"
				  height="48"
				  sprite="menu_empty3px"
				  color="5,0,2,190"
				  type="sliced" />

		  <label depth="8"
				 pos="12,-8"
				 width="154"
				 height="31"
				 font_size="18"
				 text="{chub_menu_version}"
				 color="255,215,215,255" />

		  <label depth="8"
				 pos="166,-9"
				 width="78"
				 height="30"
				 font_size="17"
				 text="{chub_menu_eac}"
				 color="90,245,135,255" />

		  <simplebutton depth="50"
						name="btnChubConsole"
						pos="252,-6"
						width="112"
						height="36"
						caption="CONSOLE"
						font_size="15"
						bordercolor="75,75,75,255"
						defaultcolor="32,30,31,235"
						hovercolor="105,15,22,245" />

		  <simplebutton depth="50"
						name="btnChubDiscordOpen"
						pos="372,-6"
						width="128"
						height="36"
						caption="OPEN DISCORD"
						font_size="15"
						bordercolor="75,75,75,255"
						defaultcolor="32,30,31,235"
						hovercolor="105,15,22,245" />

		  <simplebutton depth="50"
						name="btnChubDiscordCopy"
						pos="508,-6"
						width="128"
						height="36"
						caption="COPY LINK"
						font_size="15"
						bordercolor="75,75,75,255"
						defaultcolor="32,30,31,235"
						hovercolor="105,15,22,245" />

	  </rect>
  </append>
</configs>
